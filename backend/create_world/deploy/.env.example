# 复制为 .env 后按需修改：copy .env.example .env
# 注意：这是本地开发配置，密码可简单；不要提交 .env 到仓库

# 镜像站前缀，末尾必须带 /；留空表示走 Docker Hub 官方
# 例：MIRROR=docker.1ms.run/
MIRROR=

PG_DB=create_world
PG_USER=cw
PG_PASSWORD=cw123456

MINIO_AK=minioadmin
MINIO_SK=minioadmin
MINIO_BUCKET=create-world

# AI 密钥不放在 compose 里，供后端 application-local.yaml 用环境变量读取
AI_DASHSCOPE_API_KEY=
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
